// 娃娃衣商店資料庫結構
// 欄位依「網頁想法」手稿的前台與後台頁面設計
// 改完這個檔案後執行：npx prisma migrate dev --name <說明>

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// 會員
// ============================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypt 雜湊，不存明碼
  name      String?
  phone     String?
  note      String? // 後台會員資料表的「備註」
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  orders      Order[]
  favorites   Favorite[]
  cart        Cart?
  resetTokens PasswordResetToken[]
}

// 忘記密碼用的一次性代碼。只存雜湊，寄出的原始代碼不留在資料庫
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  CUSTOMER
  ADMIN
}

// ============================================================
// 商品
// ============================================================

// 側邊選單分類 / 後台新增商品的尺寸分頁
model Category {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)

  products Product[]
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  model       String? // 手稿的「MODEL：三圍」
  description String? // 商品詳情
  sizeChart   String? // 娃尺寸說明
  price       Int // 以整數元為單位，避免浮點誤差

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // 首頁主打商品
  featured        Boolean @default(false)
  featuredCaption String?
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images    ProductImage[]
  variants  ProductVariant[]
  favorites Favorite[]
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// 同一件商品的不同尺寸，各自算庫存
model ProductVariant {
  id        String @id @default(cuid())
  productId String
  size      String // S / M / L
  stock     Int    @default(0)
  sortOrder Int    @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size])
}

// ============================================================
// 收藏與購物車
// ============================================================

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

// 購物車。未登入時用 cookie 裡的 sessionId 認，登入後併到該會員名下
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ============================================================
// 訂單
// ============================================================

model Order {
  id      String @id @default(cuid())
  orderNo String @unique // 後台訂單列表顯示的編號，例如 00023

  userId String? // 允許未登入下單
  user   User?   @relation(fields: [userId], references: [id])

  // 聯絡資料
  email String
  name  String
  phone String

  shipping ShippingMethod
  payment  PaymentMethod

  paymentStatus PaymentStatus @default(UNPAID)
  shipStatus    ShipStatus    @default(PENDING)

  // 「從哪知道此商品」
  source      OrderSource?
  sourceOther String?

  subtotal Int
  shipFee  Int @default(0)
  total    Int

  note      String?
  createdAt DateTime @default(now())
  paidAt    DateTime?

  items OrderItem[]

  @@index([createdAt])
}

// 下單當下把品名與價格複製一份，日後商品改名改價不影響歷史訂單
model OrderItem {
  id      String @id @default(cuid())
  orderId String

  variantId   String?
  productName String
  size        String
  unitPrice   Int
  quantity    Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum ShippingMethod {
  HOME_DELIVERY // 一般宅配
  CVS_PICKUP // 超商取貨
}

enum PaymentMethod {
  COD // 貨到付款
  LINE_PAY
  CREDIT_CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum ShipStatus {
  PENDING // 未出貨
  SHIPPED // 已出貨
  RECEIVED // 已收貨
}

enum OrderSource {
  THREADS
  IG
  OTHER
}
