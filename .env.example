# 複製成 .env 後填入實際值。.env 不會進版控。

# ── 資料庫（Supabase PostgreSQL）────────────────────────
# Supabase 後台 → Connect → 有兩種連線字串，兩個都要填：
#   DATABASE_URL  用 Transaction pooler（連接埠 6543）── 網站執行時用
#   DIRECT_URL    用 Direct connection（連接埠 5432）── 建立資料表時用
# 分開的原因：連線池不支援建立資料表所需的操作，
# 而 Vercel 這類環境又必須走連線池才不會把連線數用光。
DATABASE_URL=""
DIRECT_URL=""

# 網站的對外網址。寄出的信件連結會用它組出完整網址。
APP_URL="http://localhost:3000"

# 登入 session 的簽章金鑰。請用下列指令自行產生一組：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 後台管理員帳號密碼，npm run db:seed 會依此建立／更新
SEED_ADMIN_EMAIL="admin"
SEED_ADMIN_PASSWORD="請改成你自己的密碼"


# ── 商品圖片（Supabase Storage）────────────────────────
# 留空時圖片存在本機 public/uploads/，部署到 Vercel 後會遺失。
# Supabase 後台 → Storage → 建立一個 public 的 bucket（例如 products），
# 再到 Project Settings → Storage → S3 access keys 產生金鑰。
S3_ENDPOINT="https://你的專案代號.supabase.co/storage/v1/s3"
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="products"
# 圖片對外網址，格式固定如下
S3_PUBLIC_URL="https://你的專案代號.supabase.co/storage/v1/object/public/products"


# ── 寄信（Resend）────────────────────────────────────
# 留空時信件內容只會印在伺服器終端機，不會真的寄出。
# 需要自有網域：resend.com → Domains → Add Domain → 把 DNS 記錄加到網域設定
RESEND_API_KEY=""
MAIL_FROM="LOGO 娃衣 <no-reply@你的網域>"


# ── 金流（綠界 ECPay）────────────────────────────────
# 留空時自動使用綠界官方公開的測試商店，可完整跑流程但不會真的扣款。
# 申請特約商店通過後才填這三項，填了就會切到正式環境真的收款。
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
