# 複製成 .env 後填入實際值。.env 不會進版控。

# ── 基本 ──────────────────────────────────────────────
# SQLite 資料庫位置
DATABASE_URL="file:./dev.db"

# 網站的對外網址。寄出的信件連結會用它組出完整網址。
# 本機開發留 http://localhost:3000 即可。
APP_URL="http://localhost:3000"

# 登入 session 的簽章金鑰。請用下列指令自行產生一組：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 後台管理員帳號密碼，npm run db:seed 會依此建立／更新
SEED_ADMIN_EMAIL="admin"
SEED_ADMIN_PASSWORD="請改成你自己的密碼"


# ── 寄信（Resend）────────────────────────────────────
# 留空時信件內容只會印在伺服器終端機，不會真的寄出。
# 1. 到 resend.com 註冊
# 2. Domains → Add Domain，填入你的網域
# 3. 把它給的 DNS 記錄加到網域設定裡，等驗證通過
# 4. API Keys → Create，把金鑰貼到這裡
RESEND_API_KEY=""
# 寄件者，網域必須是上面驗證過的那個
MAIL_FROM="LOGO 娃衣 <no-reply@你的網域>"


# ── 商品圖片儲存（Cloudflare R2）──────────────────────
# 留空時圖片存在本機 public/uploads/。
# 1. Cloudflare 後台 → R2 → Create bucket
# 2. bucket 的 Settings 綁一個自訂網域（或開啟 r2.dev 公開網址）
# 3. R2 → Manage API Tokens → Create，權限選 Object Read & Write
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# 圖片對外的網址開頭，例如 https://img.你的網域
R2_PUBLIC_URL=""


# ── 金流（綠界 ECPay）────────────────────────────────
# 申請特約商店後填入，測試階段可留空改用官方測試代號。
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
